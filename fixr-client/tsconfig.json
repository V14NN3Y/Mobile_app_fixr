{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    // Sans ceci, describe/it/expect/jest ne sont pas vus comme globaux (l'inclusion
    // automatique de node_modules/@types/* ne s'est pas déclenchée pour ce projet) ;
    // les autres @types/* (react, node…) restent résolus normalement via leurs imports.
    "types": ["jest"],
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts", "nativewind-env.d.ts"],
  "exclude": ["node_modules", "design", "docs"]
}
