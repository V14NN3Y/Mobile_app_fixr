# Copier en .env.local (déjà ignoré par git, voir .gitignore) et renseigner les vraies
# valeurs locales affichées par `supabase start` (section "API URL" / "anon key").
# Absent ou vide : l'app retombe automatiquement sur le faux client API (src/mocks/),
# voir src/lib/env.ts.

EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Force les mocks même si les 2 variables ci-dessus sont renseignées (démo rapide sans
# Docker, par exemple). Laisser absent/false pour utiliser le backend réel par défaut.
# EXPO_PUBLIC_USE_MOCKS=true

# Lot 9 — monitoring. Vide = SDK inactif (src/lib/sentry.ts, src/lib/posthog.ts) : aucun
# compte Sentry/PostHog n'existe encore dans cet environnement.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
